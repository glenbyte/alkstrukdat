    "def piramida_angka(number):\n",
    "    for i in range(1, number+1):\n",
    "        print(\" \" *(number - i), end=\"\")\n",
    "        for r in range(1, i + 1):\n",
    "            print(r, end=\" \")\n",
    "        \n",
    "        for g in range(1, i + 1):\n",
    "            print(g, end=\" \")\n",
    "        print()\n",
    "piramida_angka(3)\n"
   ]
  }
